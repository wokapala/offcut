# Skopiuj do .env:  cp .env.example .env   (plik .env nie trafia do repozytorium)

# PostgreSQL (kontener "db")
POSTGRES_USER=offcut
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_DB=offcut

# Backend – klucz podpisu sesji. Wygeneruj własny, np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OFFCUT_SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag
# true tylko gdy aplikacja jest serwowana przez HTTPS
OFFCUT_COOKIE_SECURE=false

# Limity optymalizatora (branch and bound)
OFFCUT_OPTIMIZER_MAX_NODES=300000
OFFCUT_OPTIMIZER_TIME_LIMIT_S=3.0

# Port, pod którym aplikacja jest dostępna na hoście
OFFCUT_HTTP_PORT=8080
